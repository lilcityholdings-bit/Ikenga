# At least one LLM key is required. Checked in this priority order:
# Groq, then Google AI Studio, then OpenRouter.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# GitHub Pages publishing target.
# Use a FINE-GRAINED token scoped to only this one repo, with
# Contents: Read and write. Never use a classic repo-scoped token.
GITHUB_TOKEN=your_token_here
GITHUB_USERNAME=your_username
GITHUB_REPO=money-bot-site
GITHUB_BRANCH=main
GITHUB_PAGES_FOLDER=docs

# Required. The dashboard refuses to load without this — it can
# start/stop bots and approve spending, and it may sit on a public URL.
DASHBOARD_PASSWORD=something_long_and_random

# Optional: serve from your own domain. CUSTOM_DOMAIN writes a CNAME file
# for GitHub Pages. SITE_BASE_URL overrides the absolute base used in
# canonical URLs / sitemap / OG tags — set it if hosting off Pages.
# CUSTOM_DOMAIN=example.com
# SITE_BASE_URL=https://example.com

# Optional measurement. ANALYTICS_SNIPPET is raw HTML injected into <head>
# (Plausible, GA4, Fathom, Cloudflare — whatever you use).
# SEARCH_CONSOLE_VERIFICATION is the content value of Google's
# google-site-verification meta tag.
# ANALYTICS_SNIPPET=<script defer data-domain="example.com" src="https://plausible.io/js/script.js"></script>
# SEARCH_CONSOLE_VERIFICATION=abc123yourverificationstring

# Optional tuning (defaults shown).
# DB_PATH=data/money_bots.db
# MAX_PUBLISHES_PER_HOUR=2
# FAILURE_THRESHOLD=5
# FAILURE_WINDOW_MINUTES=30
# HEARTBEAT_STALE_MINUTES=15
# WORKER_LOOP_INTERVAL_SECONDS=240

# Article images (Openverse, no API key). Set false to disable.
# ENABLE_ARTICLE_IMAGES=true

# --- Crypto trading (REAL MONEY once enabled — read the README's Trading
# section before touching this). CRYPTO_EXCHANGE is any ccxt exchange id.
# The API key on that exchange MUST be trade+read only — never enable
# withdrawal permission on it.
# CRYPTO_EXCHANGE=kraken
# CRYPTO_API_KEY=
# CRYPTO_API_SECRET=
# CRYPTO_QUOTE_CURRENCY=USD
# CRYPTO_TRADING_PAIRS=BTC/USD,ETH/USD
# TRADING_TIMEFRAME=1h
# TRADING_MAX_POSITION_USD=25
# TRADING_DAILY_LOSS_LIMIT_USD=50
# TRADING_MAX_OPEN_POSITIONS=2
# TRADING_LOOP_INTERVAL_SECONDS=900
