# Copy this to .env and fill in real values. NEVER commit .env to git.

# Get a free Sepolia RPC URL from Alchemy or Infura (sign up, create app, select Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Random long secrets -- generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=changeme_generate_a_real_random_secret
JWT_SECRET=changeme_generate_a_real_random_secret

ENV=development

# Safety switch -- leave false. Do not set true without an audit + legal review.
ALLOW_MAINNET=false

MAX_SLIPPAGE_BPS=300
DEFAULT_SLIPPAGE_BPS=50
QUOTE_DEADLINE_SECONDS=120
SWAP_DEADLINE_SECONDS=180

RATE_LIMIT_QUOTES=30/minute
RATE_LIMIT_SWAPS=6/minute
